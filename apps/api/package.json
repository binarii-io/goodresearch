{
  "name": "@goodresearch/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#platform/*": "./src/platform/*"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "generate": "node src/export-openapi.ts",
    "db:generate": "drizzle-kit generate && node scripts/strip-public-schema.mjs",
    "auth:schema": "auth generate --config src/platform/auth/cli-config.ts --output src/platform/auth/auth-schema.ts --adapter drizzle --dialect postgresql -y"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/google-vertex": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@fastify/static": "catalog:",
    "@fastify/swagger": "catalog:",
    "@goodresearch/config": "workspace:*",
    "@goodresearch/contracts": "workspace:*",
    "@goodresearch/shared": "workspace:*",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "fflate": "catalog:",
    "google-auth-library": "catalog:",
    "pg": "catalog:",
    "pg-boss": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@goodresearch/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "auth": "catalog:",
    "drizzle-kit": "catalog:",
    "pino-pretty": "catalog:",
    "testcontainers": "catalog:",
    "vitest": "catalog:"
  }
}
