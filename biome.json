{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/routeTree.gen.ts",
      "!packages/api-client/src/generated",
      "!packages/api-client/openapi.json",
      "!apps/api/drizzle",
      "!.specify",
      "!.claude",
      "!**/*.po",
      "!**/*.md",
      "!pnpm-lock.yaml",
      "!**/auth-schema.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "a11y": "error",
      "style": {
        "noDefaultExport": "error",
        "noEnum": "error",
        "noNonNullAssertion": "error",
        "useImportType": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.config.ts",
        "**/*.stories.tsx",
        "**/.storybook/**",
        "**/routes/**",
        "**/tests/setup/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
