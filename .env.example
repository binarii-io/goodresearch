# goodresearch configuration — see specs/001-walking-skeleton/contracts/configuration.md
# Every variable also accepts a <NAME>_FILE variant pointing to a file (Docker secrets).
# Defaults here are production-safe: no identity provider is enabled until you configure one.
# For local evaluation, use `docker compose --profile dev up`, which injects a test provider.

# Public URL of the app (https in production).
APP_URL=http://localhost:3000
# Random string of at least 32 characters, e.g. `openssl rand -base64 48`.
AUTH_SECRET=
DATABASE_URL=postgres://goodresearch:goodresearch@postgres:5432/goodresearch
# Connections per process (app pool, job queue pool). Every server and worker instance opens both:
# keep their total under the database's connection limit.
# DATABASE_POOL_MAX=10
# JOBS_POOL_MAX=10

# S3-compatible object storage.
S3_ENDPOINT=http://s3:8333
S3_REGION=us-east-1
S3_BUCKET=goodresearch
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Create the bucket at startup if missing (useful for local stores).
S3_CREATE_BUCKET=false

# Identity providers (OpenID Connect), comma-separated keys. Empty = "sign-in not configured" page.
AUTH_PROVIDERS=
# For each key, e.g. google (register the redirect URI <APP_URL>/api/auth/callback/google):
# AUTH_GOOGLE_DISPLAY_NAME=Google
# AUTH_GOOGLE_ISSUER=https://accounts.google.com
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GOOGLE_TRUSTED=false   # true = accept emails the provider does not mark as verified

# Emails that become admin at their first sign-in (comma-separated). Required.
ADMIN_EMAILS=
# Emails and domains allowed to get an account (comma-separated; an entry without @ is a domain).
ACCESS_ALLOWLIST=

# Google client (optional) for the Drive connector and Vertex AI: each consent is separate from
# sign-in. Can reuse the Google sign-in client. Register <APP_URL>/api/sources/google-drive/callback
# and <APP_URL>/api/ai-provider/google/callback, add the drive.readonly, drive (publishing) and
# cloud-platform scopes, enable the Drive, Docs and Sheets APIs (see README, Google Drive and AI
# providers). GOOGLE_DRIVE_CLIENT_ID/_SECRET are still read.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# A Google Drive simulated in memory, for local evaluation and end-to-end tests only (refused with
# an https APP_URL). compose.dev.yaml sets it.
# DRIVE_FAKE=false

# AI providers people can connect with their own account (vertex needs the Google client).
AI_PROVIDERS=vertex,anthropic,openai
# Model per provider (optional; defaults in packages/config/src/env.ts).
# AI_MODEL_VERTEX=
# AI_MODEL_ANTHROPIC=
# AI_MODEL_OPENAI=
# Dated prices in USD per million tokens, for other models or new rates (JSON array).
# AI_PRICES=[{"model":"my-model","from":"2027-01-01","inputPerMillion":1,"outputPerMillion":4}]

# Proxies whose X-Forwarded-For is trusted (comma-separated IPs or CIDRs).
TRUSTED_PROXIES=
# Sign-in attempts per client IP and minute (raise it when many people share one IP).
AUTH_SIGN_IN_RATE_LIMIT=20
LOG_LEVEL=info
# HTTP port of the server. The worker also listens on it, with GET /health only, when it is set
# (platforms that only run HTTP services); without it the worker opens no port.
PORT=3000
